# Cloud Configuration
# Copy this file to .env.local and fill in your values

# GCP Project
GOOGLE_CLOUD_PROJECT=today-in-emojis
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Cloud Storage
CLOUD_STORAGE_BUCKET=today-in-emojis-assets
CLOUD_STORAGE_REGION=us-central1

# Firestore
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=editions

# Lifecycle
ASSET_RETENTION_DAYS=30

# Mode
CLOUD_DRY_RUN=true
CLOUD_MODE=parallel

# OpenAI (required for AI emoji selection)
OPENAI_API_KEY=your-openai-api-key-here

# Essence Configuration
ESSENCE_CADENCE_N=6
ESSENCE_EMOJI_PALETTE=😢,😡,😨,😮,🙂,❤️,😔,😤,😬,🙏,🌍,⚖️
ESSENCE_TEMPERATURE=0.7
ESSENCE_FALLBACK_EMOJI=🌍
